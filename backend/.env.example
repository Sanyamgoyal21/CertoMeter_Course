PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv:db_user:

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Email (Brevo API)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=AI Career Accelerator
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
EMAIL_TO=your@gmail.com
EMAIL_TEST_TOKEN=change_me_to_a_long_random_value
# WhatsApp (optional Twilio)
WHATSAPP_NUMBER=+918360341355

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
